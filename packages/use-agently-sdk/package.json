{
  "name": "@use-agently/sdk",
  "version": "0.0.0",
  "description": "Core SDK for the Agently platform \u2014 wallet management, A2A, MCP, x402 payments",
  "homepage": "https://github.com/AgentlyHQ/use-agently/tree/main/packages/use-agently-sdk",
  "bugs": {
    "url": "https://github.com/AgentlyHQ/use-agently/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/AgentlyHQ/use-agently.git",
    "directory": "packages/use-agently-sdk"
  },
  "license": "MIT",
  "author": "AgentlyHQ",
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "bun": "./index.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    },
    "./client": {
      "types": "./dist/client.d.ts",
      "bun": "./client.ts",
      "import": "./dist/client.js",
      "require": "./dist/client.cjs"
    },
    "./a2a": {
      "types": "./dist/a2a.d.ts",
      "bun": "./a2a.ts",
      "import": "./dist/a2a.js",
      "require": "./dist/a2a.cjs"
    },
    "./mcp": {
      "types": "./dist/mcp.d.ts",
      "bun": "./mcp.ts",
      "import": "./dist/mcp.js",
      "require": "./dist/mcp.cjs"
    },
    "./agently": {
      "types": "./dist/agently.d.ts",
      "bun": "./agently.ts",
      "import": "./dist/agently.js",
      "require": "./dist/agently.cjs"
    },
    "./balance": {
      "types": "./dist/balance.d.ts",
      "bun": "./balance.ts",
      "import": "./dist/balance.js",
      "require": "./dist/balance.cjs"
    },
    "./config": {
      "types": "./dist/config.d.ts",
      "bun": "./config.ts",
      "import": "./dist/config.js",
      "require": "./dist/config.cjs"
    },
    "./wallets/wallet": {
      "types": "./dist/wallets/wallet.d.ts",
      "bun": "./wallets/wallet.ts",
      "import": "./dist/wallets/wallet.js",
      "require": "./dist/wallets/wallet.cjs"
    },
    "./wallets/evm-private-key": {
      "types": "./dist/wallets/evm-private-key.d.ts",
      "bun": "./wallets/evm-private-key.ts",
      "import": "./dist/wallets/evm-private-key.js",
      "require": "./dist/wallets/evm-private-key.cjs"
    },
    "./utils/chain": {
      "types": "./dist/utils/chain.d.ts",
      "bun": "./utils/chain.ts",
      "import": "./dist/utils/chain.js",
      "require": "./dist/utils/chain.cjs"
    },
    "./utils/transaction": {
      "types": "./dist/utils/transaction.d.ts",
      "bun": "./utils/transaction.ts",
      "import": "./dist/utils/transaction.js",
      "require": "./dist/utils/transaction.cjs"
    },
    "./testing": {
      "types": "./dist/testing.d.ts",
      "bun": "./testing.ts",
      "import": "./dist/testing.js",
      "require": "./dist/testing.cjs"
    }
  },
  "files": [
    "**/*.ts",
    "!**/*.test.ts",
    "dist",
    "README.md"
  ],
  "scripts": {
    "build": "tsdown",
    "test": "bun test"
  },
  "dependencies": {
    "@a2a-js/sdk": "^0.3.10",
    "@modelcontextprotocol/sdk": "^1.27.1",
    "@x402/evm": "^2.5.0",
    "@x402/fetch": "^2.5.0",
    "@x402/mcp": "^2.5.0",
    "viem": "^2.46.3",
    "zod": "^4"
  },
  "devDependencies": {
    "@types/bun": "^1.3.9",
    "localhost-aixyz": "^0",
    "testcontainers": "^11",
    "tsdown": "^0.16.1",
    "x402-fl": "^0"
  },
  "engines": {
    "node": ">=20"
  }
}
